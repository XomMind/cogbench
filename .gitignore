# Model weights. Fetched, not authored -- see SETUP.md.
models/

# Third-party clone: noemica/cog-minder, for bots.json and the combat simulator.
# Cloned rather than vendored so it can be updated independently.
cog-minder/

# Reproducible from COGMIND.exe via extract_proto.py --raw.
schema/*.fdp

__pycache__/
*.pyc

# ~/.gitignore_global excludes *.md, which would silently drop every document
# here -- including notes/b17.1-luigiai.md, the reverse-engineering record this
# work depends on. Repo rules take precedence over core.excludesfile.
!*.md
!notes/*.md

# Staged build context for the container image: copies of the files listed in
# k8s/build.sh, written next to the Dockerfile because BuildKit cannot read
# outside its context. Generated on every build, never edited.
#
# statmind/ was missed when the reader moved into the image and sdl/ would have
# been missed the same way -- together they are ~9MB of duplicated source, and
# committing a copy is how the copy starts drifting from the original.
k8s/image/harness/
k8s/image/statmind/
k8s/image/sdl/

# Glyph measurements, rebuilt from the font on demand.
.glyphcache.json

# Recorded observation traces. Output of a run, not input to one.
data/*.jsonl
